# ============================================================
#  AWS Cloud Backup & Restore  -  Environment Variables
# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git.

# --- AWS IAM user credentials (NOT your root account) ---
# Create an IAM user with programmatic access and only S3 + DynamoDB
# permissions (see README "IAM" section), then paste its keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWS region (where your bucket + table live) ---
AWS_REGION=ap-south-1

# --- Amazon S3 ---
S3_BUCKET_NAME=your-unique-bucket-name

# --- Amazon DynamoDB ---
DYNAMODB_TABLE_NAME=BackupFiles
DYNAMODB_USERS_TABLE=BackupUsers

# --- Auth / JWT ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
